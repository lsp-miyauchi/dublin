#include <windows.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <limits.h>


///////////////////////////////////////////////////////////////
// DDDDDMMMMYYYxxxx
// 1111111111111111
// mask d=0xf800
//      m=0x0780
//      y=0x0070
//
#define K2E_DAY(d)		(((d) & 0xf800) >> 11)
#define K2E_MON(d)		(((d) & 0x0780) >> 7)
#define K2E_YEAR(d)		(((d) & 0x0070) >> 4)
#define K2C_DAY(d)		(((d) << 11) & 0xf800)
#define K2C_MON(d)		(((d) << 7) & 0x0780)
#define K2C_YEAR(d)		(((d) << 4) & 0x0070)

#define CRCPOLY16		0x1021
#define CRCPOLY32		0x04C11DB7

#define LODWORD(a)				(*((DWORD*)&(a)))
#define HIDWORD(a)				(*(((DWORD*)&(a)) + 1))
#define SETDWORDLONG(a,b,c)		(*((DWORD*)&(a))=(b),*(((DWORD*)&(a))+1)=(c))

static char maptbl[] = "0123456789ABCDEF";



_inline static void initcrc16tbl(WORD* ptbl)
{
	register WORD i, j , r;
	for (i = 0; i <= UCHAR_MAX; i++)
	{
		r = i << (16 - CHAR_BIT);
		for (j = 0; j < CHAR_BIT; j++)
		{
			if (r & 0x8000)
				r = (r << 1) ^ CRCPOLY16;
			else
				r <<= 1;
		}
		ptbl[i] = r & 0xFFFF;
	}
}

_inline WORD crc16(int n, BYTE* pcb, WORD* ptbl)
{
	register WORD r = 0xFFFF;
	while (--n >= 0)
		r = (r << CHAR_BIT) ^ ptbl[(BYTE)(r >> (16 - CHAR_BIT)) ^ *pcb++];
	return ~r & 0xFFFF;
}

_inline DWORDLONG getmapvalue(LPCSTR pszString)
{
	register char* p;
	DWORDLONG dl = 0;
	while (*pszString)
	{
		p = maptbl;
		while (*p)
		{
			if (*p == toupper(*pszString))
			{
				dl = Int64ShllMod32(dl, 4);
				dl |= (DWORDLONG)(p - maptbl);
				break;
			}
			p++;
		}
		pszString++;
	}
	return dl;
}

