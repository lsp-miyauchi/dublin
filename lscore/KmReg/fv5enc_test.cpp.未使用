// êVÇµÇ¢ÉpÉXÇÕ -s1- -s2- -s3- -s4-
//              ----                     !CRC16
//                   --                  HI-SEQ BYTE
//                     -x                LO-DATE BYTE
//                        --             HI-DATE BYTE
//                          --           LO-SEQ BYTE
//                             ----      CRC16

void fv5_encnum(int year, int month, int day, int seq, LPSTR code)
{
	WORD crc16tbl[UCHAR_MAX + 1];
	initcrc16tbl(crc16tbl);

	char body[16];
	WORD s1, s2, s3, s4, date;
	date = K2C_YEAR(year - 2001) + K2C_MON(month) + K2C_DAY(day);
	s2 = (HIBYTE(seq) << 8) | LOBYTE(date);
	s3 = (HIBYTE(date) << 8) | LOBYTE(seq);
	sprintf(body, "%04X%04X", s2, s3);
	s4 = crc16(8, (BYTE*)body, crc16tbl);
	s1 = 0xffff ^ s4;
	sprintf(code, "%04X-%04X-%04X-%04X", s1, s2, s3, s4);
}

#define S1(a)		(HIWORD(HIDWORD((a))))
#define S2(a)		(LOWORD(HIDWORD((a))))
#define S3(a)		(HIWORD(LODWORD((a))))
#define S4(a)		(LOWORD(LODWORD((a))))

void fv5_decnum(LPSTR code)
{
	WORD crc16tbl[UCHAR_MAX + 1];
	initcrc16tbl(crc16tbl);

	WORD crc, date;
	DWORDLONG dl = getmapvalue(code);
	printf("%08X%08X\n", HIDWORD(dl), LODWORD(dl));

	if ((0xffff ^ S1(dl)) != S4(dl))
		printf("1st crc unmatched with 2nd crc\n");
	char tmp[16];
	int len = sprintf(tmp, "%04X%04X", S2(dl), S3(dl));
	crc = crc16(len, (BYTE*)tmp, crc16tbl);
	if (crc != S4(dl))
		printf("crc error\n");
	date = (S3(dl) & 0xff00) | LOBYTE(S2(dl));
	printf("%d %d %d\n", K2E_YEAR(date) + 2001, K2E_MON(date), K2E_DAY(date));
	printf("seq = %d\n", (S2(dl) & 0xff00) | LOBYTE(S3(dl)));
}

void main(int argc, char** argv)
{
	if (argc != 5)
		return;

	char code[256];
	fv5_encnum(atoi(argv[1]), atoi(argv[2]), atoi(argv[3]), atoi(argv[4]), code);
	printf("%s\n", code);

	fv5_decnum(code);
}
