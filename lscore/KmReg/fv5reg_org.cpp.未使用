_inline WORD wordrot_left(WORD w, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (w & 0x8000);
		w <<= 1;
		if (flg)
			w |= 1;
		bits--;
	}
	return w;
}

_inline WORD wordrot_right(WORD w, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (w & 1);
		w >>= 1;
		if (flg)
			w |= 0x8000;
		bits--;
	}
	return w;
}

_inline DWORD dwordrot_left(DWORD dw, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (dw & 0x80000000);
		dw <<= 1;
		if (flg)
			dw |= 1;
		bits--;
	}
	return dw;
}

_inline DWORD dwordrot_right(DWORD dw, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (dw & 1);
		dw >>= 1;
		if (flg)
			dw |= 0x80000000;
		bits--;
	}
	return dw;
}

