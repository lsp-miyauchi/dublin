//              ----                PREFIX(LOBYTE=pref, HIBYTE=check)
extern "C"
void WINAPI KrFV5(int prx, int year, int month, int day, int seq, LPSTR pszSeq)
{
	int delta;
	if (seq & 1)
		delta = seq & 0xff;
	else
		delta = (seq & 0xff00) >> 8;
	if (!delta)
		delta++;
	delta = ((delta & 0xf) << 4) | ((delta & 0xf0) >> 4);
	prx |= ((delta << 8) & 0xff00);

	year -= 2000;
	WORD dates = K2C_YEAR(year) + K2C_MON(month) + K2C_DAY(day);
	dates = (dates & 0xfff8) | ((year + month + day) & 7);

	WORD arr[3];
	arr[0] = prx;
	arr[1] = dates;
	arr[2] = seq;
	WORD crc = crc16(6, (BYTE*)arr);
	crc = (((crc & 0xff00) >> 8) | ((crc & 0x00ff) << 8));
	crc ^= dates;

	prx = wordrot_right((WORD)prx, HIBYTE(crc) & 7);
	dates = wordrot_right(dates, HIBYTE(crc) & 7);
	seq = wordrot_left((WORD)seq, LOBYTE(crc) & 7);

	DWORD hi = MAKELONG(dates, prx);
	DWORD lo = MAKELONG(crc, seq);
	hi = dwordrot_right(hi, 3);
	lo = dwordrot_left(lo, 3);

#ifdef BLOWFISH_ENCRYPT
	DWORD bfdata[2];
	bfdata[0] = hi;
	bfdata[1] = lo;

	BF_KEY key;
	bf_setkey(&key, 10, (BYTE*)"FileVisor5");
	bf_encrypt(bfdata, &key);

	hi = bfdata[0];
	lo = bfdata[1];
#endif

	wsprintf(pszSeq, "%04X-%04X-%04X-%04X",
			HIWORD(hi), LOWORD(hi), HIWORD(lo), LOWORD(lo));
}

static char sszEncBuff[128];

extern "C"
LPCSTR WINAPI KrFV5Ex(int nPrx, int nYear, int nMonth, int nDay, int nSeqNumber)
{
	KrFV5(nPrx, nYear, nMonth, nDay, nSeqNumber, sszEncBuff);
	return sszEncBuff;
}
