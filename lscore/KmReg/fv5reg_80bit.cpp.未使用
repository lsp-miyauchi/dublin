_inline WORD wordrot_left(WORD w, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (w & 0x8000);
		w <<= 1;
		if (flg)
			w |= 1;
		bits--;
	}
	return w;
}

_inline WORD wordrot_right(WORD w, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (w & 1);
		w >>= 1;
		if (flg)
			w |= 0x8000;
		bits--;
	}
	return w;
}

_inline DWORD dwordrot_left(DWORD dw, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (dw & 0x80000000);
		dw <<= 1;
		if (flg)
			dw |= 1;
		bits--;
	}
	return dw;
}

_inline DWORD dwordrot_right(DWORD dw, int bits)
{
	while (bits > 0)
	{
		BOOL flg = (dw & 1);
		dw >>= 1;
		if (flg)
			dw |= 0x80000000;
		bits--;
	}
	return dw;
}

BYTE __fastcall byte_rangerot_left(BYTE w, int range, int rot)
{
	BYTE chkbit = 1;
	BYTE mask = 1;
	while (--range > 0)
	{
		chkbit <<= 1;
		mask = (mask << 1) | 1;
	}

	BYTE save = w & (0xff^mask);
	w &= mask;
	while (rot > 0)
	{
		BOOL flg = (w & chkbit);
		w <<= 1;
		if (flg)
			w |= 1;
		rot--;
	}
	return (save | (w & mask));
}

