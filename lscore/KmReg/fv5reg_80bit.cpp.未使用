extern "C"
void WINAPI KrFV6(int prx, int year, int month, int day, int seq, LPSTR pszSeq)
{
	BYTE bitkey[10];

	int index = seq % 6;
	year -= 2003;
	WORD date_1 = K2C_YEAR(year) + K2C_MON(month) + K2C_DAY(day);
	WORD date_2 = L2C_YEAR(year) + L2C_MON(month) + L2C_DAY(day);

	seq += date_2;

	BYTE prx_1 = byte_rangerot_left((BYTE)prx, 7, index + 1);
	BYTE prx_2 = byte_rangerot_right((BYTE)prx, 7, index + 1);

	bitkey[2] = (BYTE)((seq >> 9) & 0xff);
	bitkey[3] = (BYTE)((seq >> 1) & 0xff);
	bitkey[4] = (BYTE)((seq << 7) & 0x80) |
				(BYTE)(date_1 >> 7);
	bitkey[5] = (BYTE)((date_1 << 1) & 0xfe) |
				(prx_1 >> 6);
	bitkey[6] = (prx_1 << 2) |
				(BYTE)(((date_2) >> 12) & 0x03);
	bitkey[7] = (BYTE)((date_2 >> 4) & 0xff);
	bitkey[8] = (BYTE)((date_2 << 4) & 0xf0) |
				(BYTE)(prx_2 >> 3);
	bitkey[9] = (BYTE)((prx_2 << 5) & 0xf0) | index + 1;

	WORD crc = crc16(8, &bitkey[2]);
	bitkey[0] = (BYTE)(crc >> 8);
	bitkey[1] = (BYTE)(crc & 0xff);

	DWORD bfdata[2];
	bfdata[0] = *((DWORD*)bitkey);
	bfdata[1] = *((DWORD*)bitkey + 1);

	BF_KEY key;
	bf_setkey(&key, 2, (BYTE*)&bitkey[8]);
	bf_encrypt(bfdata, &key);

	*((DWORD*)bitkey) = bfdata[0];
	*((DWORD*)bitkey + 1) = bfdata[1];

	int pos = 0;
	char* p = pszSeq;
	for (int i = 0; i < 16; i++)
	{
		int n = get5bit(bitkey, i);
		if (i < 15)
			*p++ = mapbyte_fv5[index * 32 + n] + 0x20;
		else
			*p++ = '0' + n;
		pos++;
		if (!(pos % 4))
			*p++ = '-';
	}
	pszSeq[19] = '\0';
}

extern "C"
LPCSTR WINAPI KrFV6Ex(int nPrx, int nYear, int nMonth, int nDay, int nSeqNumber)
{
	KrFV6(nPrx, nYear, nMonth, nDay, nSeqNumber, sszEncBuff);
	return sszEncBuff;
}

extern "C"
BOOL WINAPI KrFV6_Decode(LPCSTR pszSrc, LPSTR pszDst)
{
	char buf[MAX_PATH];
	char* p = (char*)pszSrc;
	char* q = buf;
	while (*p)
	{
		if (*p != '-')
		{
			if (*(p + 1))
				*q++ = *p - 0x20;
			else
				*q++ = *p;
		}
		p++;
	}
	*q = '\0';

	int index = buf[15] - '1';
	if (index < 0 || index > 5)
	{
		lstrcpy(pszDst, "index error");
		return FALSE;
	}

	BYTE bitkey[10];
	memset(bitkey, 0, sizeof(bitkey));
	q = buf;
	for (int i = 0; i < 16; i++)
	{
		if (i < 15)
		{
			for (int j = 0; j < 32; j++)
			{
				if (mapbyte_fv5[index * 32 + j] == *q)
				{
					put5bit(bitkey, i, j);
					break;
				}
			}
			if (j == 32)
			{
				lstrcpy(pszDst, "mapchar error");
				return FALSE;
			}
		}
		else
			put5bit(bitkey, i, index + 1);
		q++;
	}

	DWORD bfdata[2];
	bfdata[0] = *((DWORD*)bitkey);
	bfdata[1] = *((DWORD*)bitkey + 1);

	BF_KEY key;
	bf_setkey(&key, 2, (BYTE*)&bitkey[8]);
	bf_decrypt(bfdata, &key);

	*((DWORD*)bitkey) = bfdata[0];
	*((DWORD*)bitkey + 1) = bfdata[1];

	WORD crc = ((WORD)bitkey[0] << 8) | (WORD)bitkey[1];
	if (crc != crc16(8, &bitkey[2]))
	{
		lstrcpy(pszDst, "crc error");
		return FALSE;
	}

	BYTE prx_2  = ((bitkey[8] & 0x0f) << 3) |
				  (bitkey[9] >> 5);
	prx_2 = byte_rangerot_left(prx_2, 7, index + 1);

	WORD date_2 = (((WORD)bitkey[6] & 3) << 12) |
				  ((WORD)bitkey[7] << 4) |
				  ((WORD)bitkey[8] >> 4);
	BYTE prx_1  = ((bitkey[5] & 1) << 6) |
				  (bitkey[6] >> 2);
	prx_1 = byte_rangerot_right(prx_1, 7, index + 1);

	WORD date_1 = (((WORD)bitkey[4] & 0x7f) << 7) | 
				  (((WORD)bitkey[5] & 0xfe) >> 1);
	DWORD seq   = ((DWORD)bitkey[2] << 9) |
				  ((DWORD)bitkey[3] << 1) |
				  (((DWORD)bitkey[4] & 0x80) >> 7);

	if (prx_2 != prx_1)
	{
		wsprintf(pszDst, "prefix error 1=%02X, 2=%02X", prx_1, prx_2);
		return FALSE;
	}

	if (seq < date_2)
	{
		lstrcpy(pszDst, "sequence error");
		return FALSE;
	}
	seq -= date_2;

	if ((K2E_YEAR(date_1) != L2E_YEAR(date_2)) ||
		(K2E_MON(date_1) != L2E_MON(date_2)) ||
		(K2E_DAY(date_1) != L2E_DAY(date_2)))
	{
		lstrcpy(pszDst, "date match error");
		return FALSE;
	}

	int year = K2E_YEAR(date_1) + 2003;
	int mon = K2E_MON(date_1);
	int day = K2E_DAY(date_1);

	if ((seq % 6) != index)
	{
		lstrcpy(pszDst, "seq index mod error");
		return FALSE;
	}

	wsprintf(pszDst, "%04d/%02d/%02d: %d", year, mon, day, seq);
	return TRUE;
}

