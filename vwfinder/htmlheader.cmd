REM -- resource.h からマップ ファイルを作成します
echo // htmlheader.cmd が生成したヘッダファイル >"html\html_vwfnd.h"
echo. >>"html\html_vwfnd.h"
echo // コマンド (ID_* and IDM_*) >>"html\html_vwfnd.h"
"%VS71COMNTOOLS%\makehm.exe" ID_,IDH_,0x10000 IDM_,IDH_M_,0x10000 resource.h >>"html\html_vwfnd.h"
echo. >>"html\html_vwfnd.h"
echo // プロンプト (IDP_*) >>"html\html_vwfnd.h"
"%VS71COMNTOOLS%\makehm.exe" IDP_,IDH_P_,0x30000 resource.h >>"html\html_vwfnd.h"
echo. >>"html\html_vwfnd.h"
echo // リソース (IDR_*) >>"html\html_vwfnd.h"
"%VS71COMNTOOLS%\makehm.exe" IDR_,IDH_R_,0x20000 resource.h >>"html\html_vwfnd.h"
echo. >>"html\html_vwfnd.h"
echo // ダイアログ (IDD_*) >>"html\html_vwfnd.h"
"%VS71COMNTOOLS%\makehm.exe" IDD_,IDH_D_,0x20000 resource.h >>"html\html_vwfnd.h"
echo. >>"html\html_vwfnd.h"
echo // フレーム コントロール (IDW_*) >>"html\html_vwfnd.h"
"%VS71COMNTOOLS%\makehm.exe" IDW_,IDH_W_,0x50000 resource.h >>"html\html_vwfnd.h"

echo // htmlheader.cmd が生成したヘッダファイル >"html\html_ctrl.h"
echo. >>"html\html_ctrl.h"
echo // フレーム コントロール (IDC_*) >>"html\html_ctrl.h"
"%VS71COMNTOOLS%\makehm.exe" IDC_,IDH_C_,0x50000 resource.h >>"html\html_ctrl.h"
