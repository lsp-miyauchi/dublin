/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_FRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新しい検索(&F)\tCtrl+F",           IDM_EXEC_FIND
        MENUITEM SEPARATOR
        MENUITEM "オープン(&O)",                    IDM_FILE_OPEN
        MENUITEM "コピー(&C)...",                  IDM_FILE_COPY
        MENUITEM "移動(&M)...",                   IDM_FILE_MOVE
        MENUITEM "名前の変更(&N)...",                IDM_FILE_RENAME
        MENUITEM "削除(&D)\tDel",                 IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "指定ファイルをFileVisorで選択(&J)\tCtrl+J", IDM_FILE_JUMP
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tEsc",                 ID_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "オブジェクトの切り取り(&T)\tCtrl+Del",   IDM_EDIT_CUT
        MENUITEM "オブジェクトのコピー(&C)\tCtrl+Ins",    IDM_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "名前のみコピー(&N)",                 IDM_COPY_NAMEONLY
        MENUITEM "詳細情報とともにコピー(&D)",             IDM_COPY_DETAIL
        MENUITEM "フルパス名をコピー(&T)",               IDM_COPY_FULLNAME
        MENUITEM "フルパス名を短い名前でコピー(&S)",          IDM_COPY_SHORTNAME
        MENUITEM SEPARATOR
        MENUITEM "すべて選択・または解除(&U)\tCtrl+A",     IDM_FILE_SELALL
        MENUITEM "選択の切り替え(&R)",                 IDM_FILE_SELREV
        MENUITEM "クリア(&C)",                     IDM_FILE_CLEAR
    END
    POPUP "表示(&V)"
    BEGIN
        POPUP "ソート方法"
        BEGIN
            MENUITEM "ソートしない(&U)",                  IDM_SORT_NONE
            MENUITEM SEPARATOR
            MENUITEM "名前順(&N)",                     IDM_SORT_NAME
            MENUITEM "拡張子順(&E)",                    IDM_SORT_EXT
            MENUITEM "サイズ順(&S)",                    IDM_SORT_SIZE
            MENUITEM "更新日付順(&D)",                   IDM_SORT_TIME
            MENUITEM "属性順(&A)",                     IDM_SORT_ATTR
            MENUITEM "種類順(&T)",                     IDM_SORT_TYPE
            MENUITEM "パス名順(&P)",                    IDM_SORT_PATH
            MENUITEM SEPARATOR
            MENUITEM "昇順でソート(&U)",                  IDM_SORT_UP
            MENUITEM "降順でソート(&D)",                  IDM_SORT_DOWN
        END
        MENUITEM SEPARATOR
        MENUITEM "ファイル情報(&I)...",               IDM_VIEW_FILEINFO
        MENUITEM "ファイル内容表示(&V)",                IDM_TOOL_VIEWER
        MENUITEM "バイナリダンプ(&B)",                 IDM_TOOL_BDUMP
        MENUITEM SEPARATOR
        MENUITEM "ユーザ設定(&S)...",                IDM_TOOL_SETUP
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                  ID_HELP
        MENUITEM "ファインダーについて...(&A)",   ID_APP_ABOUT
    END
END


