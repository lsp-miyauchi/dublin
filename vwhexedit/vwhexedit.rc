/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_BJAIL MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規作成(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM "開く(&O)\tCtrl+O",              ID_FILE_OPEN
        MENUITEM "上書き保存(&S)\tCtrl+S",           ID_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...",             ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        POPUP "最近使ったファイル(&F)"
        BEGIN
            MENUITEM "（なし）",                        ID_FILE_MRU_FILE1, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tAlt+F4",              ID_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "切り取り(&T)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "テキスト形式でコピー(T)\tShift+Ctrl+C", ID_EDIT_TEXTCOPY
        MENUITEM "貼り付け(&P)\tCtrl+V",            ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "すべてを選択(&A)",                  ID_EDIT_SELECTALL
        MENUITEM "範囲を指定して選択(&R)...\tCtrl+R",    ID_EDIT_RANGESEL
        MENUITEM SEPARATOR
        MENUITEM "選択範囲をファイルに保存...(&W)",         ID_EDIT_SELSAVENEW
        MENUITEM "選択範囲を別のエディタで編集(&O)",          ID_EDIT_BYNEWEDITOR
        MENUITEM SEPARATOR
        MENUITEM "前のマークまで選択\tShift+Ctrl+F8",    ID_EDIT_SELTO_PREVMARK
        MENUITEM "次のマークまで選択\tCtrl+F8",          ID_EDIT_SELTO_NEXTMARK
    END
    POPUP "検索(&M)"
    BEGIN
        MENUITEM "検索(&F)...\tCtrl+F",           ID_EDIT_FIND
        MENUITEM "前方へ検索(&B)\tShift+F3",         ID_FIND_PREV
        MENUITEM "後方へ検索(&N)\tF3",               ID_FIND_NEXT
        MENUITEM SEPARATOR
        MENUITEM "ファイルの先頭\tCtrl+Home",          ID_JUMP_FILETOP
        MENUITEM "ファイルの最後\tCtrl+End",           ID_JUMP_FILEEND
        MENUITEM "指定位置へ...\tCtrl+J",            ID_JUMP_OFFSET
        MENUITEM "最後に編集した場所へ",                  ID_JUMP_LASTEDIT
        MENUITEM SEPARATOR
        MENUITEM "この位置をマーク/マーク解除\tCtrl+M",      ID_MARK_ADDRESS
        MENUITEM "前のマークへ\tShift+F8",            ID_MARK_PREV
        MENUITEM "次のマークへ\tF8",                  ID_MARK_NEXT
        MENUITEM "すべてのマークをクリア\tF12",            ID_MARK_CLEARALL
    END
    POPUP "ツール(&T)"
    BEGIN
        MENUITEM "選択範囲のチェックサム(&C)...",          ID_TOOL_CHECKSUM
    END
    POPUP "表示(&V)"
    BEGIN
        POPUP "文字セット(&F)"
        BEGIN
            MENUITEM "ASCII(&A)",                   ID_TEXT_ASCII
            MENUITEM "SJIS(&S)",                    ID_TEXT_SJIS
        END
        MENUITEM SEPARATOR
        MENUITEM "動作環境(&V)",                    ID_ENVIRON_SETUP
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                     ID_HELP
        MENUITEM "バイナリエディタについて...(&A)",         ID_APP_ABOUT
    END
END


