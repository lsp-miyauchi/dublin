/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_FRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "開く(&O)...\tCtrl+O",           IDM_FILE_OPEN
        MENUITEM "新規作成(&N)...\tCtrl+N",         IDM_FILE_NEW
        MENUITEM "クリップボードを開く",                  IDM_FILE_OPENCLIPBOARD
        MENUITEM "保存(&S)\tCtrl+S",              IDM_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...",             IDM_FILE_SAVEAS
        MENUITEM "壁紙として保存(&W)...",              IDM_FILE_WALLPAPER
        POPUP "形式を指定して書き出し(&W)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM "スキャナまたはカメラから(&K)...",         IDM_FILE_TWAIN
        MENUITEM SEPARATOR
        MENUITEM "印刷(&P)\tCtrl+P",              IDM_FILE_PRINT
        MENUITEM SEPARATOR
        POPUP "最近開いたファイル(&F)"
        BEGIN
            MENUITEM "（なし）",                        ID_FILE_MRU_FILE1, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&Q)",                     IDM_FILE_CLOSE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "やり直し(&U)\tCtrl+Z",            IDM_EDIT_UNDO
        MENUITEM "コピー(&C)\tCtrl+C",             IDM_EDIT_COPY
        MENUITEM "貼付け(&P)\tCtrl+V",             IDM_EDIT_PASTE
        MENUITEM "すべて選択(&A)\tCtrl+A",           IDM_EDIT_SELALL
        MENUITEM "選択を解除(&D)\tCtrl+D",           IDM_EDIT_SELCANCEL
        MENUITEM SEPARATOR
        MENUITEM "指定サイズで選択(&S)...",             IDM_EDIT_SIZECLIP
    END
    POPUP "イメージ(&I)"
    BEGIN
        POPUP "色解像度の変更(&C)"
        BEGIN
            MENUITEM "RGBカラー(&C)",                  IDM_COLOR_FULLCOLOR
            MENUITEM "減色(&Q)...\tF5",               IDM_COLOR_QUANTIZE
            MENUITEM "使用色数の計算(N)...",               IDM_COLOR_COUNT
            MENUITEM SEPARATOR
            MENUITEM "カラーテーブルの編集(&P)...",           IDM_COLOR_PALETTE
        END
        POPUP "色調の変更(&V)"
        BEGIN
            MENUITEM SEPARATOR
        END
        MENUITEM SEPARATOR
        MENUITEM "イメージサイズ(&S)...\tF9",          IDM_RESIZE_ZOOM
        MENUITEM "カンバスサイズ(&C)...",              IDM_RESIZE_CANVAS
        MENUITEM "トリミング(&X)\tCtrl+X",           IDM_RESIZE_TRIM
        POPUP "回転(&R)"
        BEGIN
            MENUITEM "左右反転(&M)",                    IDM_ROTATE_MIRROR
            MENUITEM "上下反転(&F)",                    IDM_ROTATE_FLIP
            MENUITEM "左へ90度回転(&L)\tCtrl+L",         IDM_ROTATE_LEFT
            MENUITEM "右へ90度回転(&R)\tCtrl+R",         IDM_ROTATE_RIGHT
        END
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "ナビゲ－タ(&V)\tF12",              IDM_TOOL_NAVIGATOR
        MENUITEM SEPARATOR
        MENUITEM "拡大(&I)\tCtrl+PgUp, +",        IDM_ZOOM_IN
        MENUITEM "縮小(&O)\tCtrl+PgDn, -",        IDM_ZOOM_OUT
        MENUITEM "原寸(&D)\tCtrl+Home, *",        IDM_ZOOM_NONE
        MENUITEM "全体を表示(&F)\tCtrl+End, /",      IDM_ZOOM_FIT
        MENUITEM "幅に合わせる(&H)",                  IDM_ZOOM_FITHORZ
        MENUITEM "高さに合わせる(&V)",                 IDM_ZOOM_FITVERT
        MENUITEM SEPARATOR
        MENUITEM "グリッドを表示(&G)\tCtrl+Alt+G",     IDM_OPTION_GRID
        MENUITEM "ツールバーを小さいボタンで(&T)",           IDM_TOOL_TBSMALL
        MENUITEM SEPARATOR
        MENUITEM "動作環境の設定(&S)...",              IDM_OPTION_SETUP
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                     ID_HELP
        MENUITEM "イメージエディタについて...(&A)",         ID_APP_ABOUT
    END
END

IDR_VIEW MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "開く(&O)...\tCtrl+O",           IDM_FILE_OPEN
        MENUITEM "印刷(&P)\tCtrl+P",              IDM_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "削除(&D)...\tDel",              IDM_FILE_DELETE
        MENUITEM SEPARATOR
        POPUP "最近開いたファイル(&F)"
        BEGIN
            MENUITEM "（なし）",                        ID_FILE_MRU_FILE1, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&Q)",                     IDM_FILE_CLOSE
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "コピー(&C)\tCtrl+C",             IDM_EDIT_COPY
        MENUITEM "すべて選択(&A)\tCtrl+A",           IDM_EDIT_SELALL
        MENUITEM "選択を解除(&D)\tCtrl+D",           IDM_EDIT_SELCANCEL
        MENUITEM SEPARATOR
        MENUITEM "指定サイズで選択(&S)...",             IDM_EDIT_SIZECLIP
        MENUITEM SEPARATOR
        MENUITEM "編集用に画像を開く(&O)\tCtrl+E",       IDM_EXEC_EDITOR
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "拡大(&S)\tCtrl+PgUp, +",        IDM_ZOOM_IN
        MENUITEM "縮小(&O)\tCtrl+PgDn, -",        IDM_ZOOM_OUT
        MENUITEM "原寸(&D)\tCtrl+Home, *",        IDM_ZOOM_NONE
        MENUITEM "全体を表示(&F)\tCtrl+End, /",      IDM_ZOOM_FIT
        MENUITEM "幅に合わせる(&H)\tCtrl+W",          IDM_ZOOM_FITHORZ
        MENUITEM "高さに合わせる(&V)\tCtrl+H",         IDM_ZOOM_FITVERT
        MENUITEM SEPARATOR
        MENUITEM "手のひらツール(&G)",                 IDM_MODE_GRAB
        MENUITEM "矩形選択ツール(&R)",                 IDM_MODE_SEL
        MENUITEM SEPARATOR
        MENUITEM "左へ90度回転(&L)\tCtrl+L",         IDM_ROTATE_LEFT
        MENUITEM "右へ90度回転(&R)\tCtrl+R",         IDM_ROTATE_RIGHT
        MENUITEM SEPARATOR
        MENUITEM "前の画像(&P)\tAlt+←, Ctrl+Space", IDM_FILE_PREV
        MENUITEM "次の画像(&N)\tAlt+→, Space",      IDM_FILE_NEXT
        MENUITEM SEPARATOR
        MENUITEM "ツールバーを小さいボタンで(&T)",           IDM_TOOL_TBSMALL
    END
    POPUP "ツール(&T)"
    BEGIN
        MENUITEM "この場所をマップで表示(&G)\tF10",        IDM_TOOL_GPS
        MENUITEM SEPARATOR
        MENUITEM "スライドショウ\tF5, Ctrl+G",         IDM_EXEC_SLIDESHOW
    END
    POPUP "ウィンドウ(&W)"
    BEGIN
        MENUITEM "サムネイルリストを表示(&T)\tF12, Ctrl+T", IDM_TOOL_THUMBLIST
        MENUITEM "サムネイルリストの配置を変更(&L)",          IDM_TOOL_THUMBLIST_LAYOUT
        MENUITEM SEPARATOR
        MENUITEM "イメージ情報(&I)\tF11, Ctrl+I",     IDM_TOOL_EXIFINFO
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                     ID_HELP
        MENUITEM "イメージビュアについて...(&A)",          ID_APP_ABOUT
    END
END

IDR_SLIDESHOW MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "ひとつ戻る(&P)",                   IDM_SLIDESHOW_PREV
        MENUITEM "ひとつ進む(&N)",                   IDM_SLIDESHOW_NEXT
        MENUITEM SEPARATOR
        MENUITEM "コピー(&C)",                     IDM_EDIT_COPY
        MENUITEM "編集用に画像を開く(&E)",               IDM_EXEC_EDITOR
        MENUITEM SEPARATOR
        MENUITEM "概要情報を表示(&I)",                 IDM_SLIDESHOW_INFORMATION
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)",                      ID_APP_EXIT
    END
END


