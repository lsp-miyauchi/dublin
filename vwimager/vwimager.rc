    VK_PRIOR,       IDM_ZOOM_IN,            VIRTKEY, CONTROL, NOINVERT
    "+",            IDM_ZOOM_IN,            ASCII,  NOINVERT
    VK_HOME,        IDM_ZOOM_NONE,          VIRTKEY, CONTROL, NOINVERT
