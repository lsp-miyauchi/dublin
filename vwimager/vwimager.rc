// Accelerator
//

IDR_FRAME ACCELERATORS
BEGIN
    VK_F5,          IDM_COLOR_QUANTIZE,     VIRTKEY, NOINVERT
    "C",            IDM_EDIT_COPY,          VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      IDM_EDIT_COPY,          VIRTKEY, CONTROL, NOINVERT
    "V",            IDM_EDIT_PASTE,         VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      IDM_EDIT_PASTE,         VIRTKEY, SHIFT, NOINVERT
    "A",            IDM_EDIT_SELALL,        VIRTKEY, CONTROL, NOINVERT
    "D",            IDM_EDIT_SELCANCEL,     VIRTKEY, CONTROL, NOINVERT
    "Z",            IDM_EDIT_UNDO,          VIRTKEY, CONTROL, NOINVERT
    VK_ESCAPE,      IDM_FILE_CLOSE,         VIRTKEY, NOINVERT
    VK_RETURN,      IDM_FILE_CLOSE,         VIRTKEY, NOINVERT
    VK_RIGHT,       IDM_FILE_NEXT,          VIRTKEY, ALT, NOINVERT
    "O",            IDM_FILE_OPEN,          VIRTKEY, CONTROL, NOINVERT
    VK_LEFT,        IDM_FILE_PREV,          VIRTKEY, ALT, NOINVERT
    "P",            IDM_FILE_PRINT,         VIRTKEY, CONTROL, NOINVERT
    "S",            IDM_FILE_SAVE,          VIRTKEY, CONTROL, NOINVERT
    "G",            IDM_OPTION_GRID,        VIRTKEY, CONTROL, ALT, NOINVERT
    "X",            IDM_RESIZE_TRIM,        VIRTKEY, CONTROL, NOINVERT
    VK_F9,          IDM_RESIZE_ZOOM,        VIRTKEY, NOINVERT
    "N",            IDM_FILE_NEW,           VIRTKEY, CONTROL, NOINVERT
    "L",            IDM_ROTATE_LEFT,        VIRTKEY, CONTROL, NOINVERT
    "R",            IDM_ROTATE_RIGHT,       VIRTKEY, CONTROL, NOINVERT
    VK_DIVIDE,      IDM_ZOOM_FIT,           VIRTKEY, NOINVERT
    VK_END,         IDM_ZOOM_FIT,           VIRTKEY, CONTROL, NOINVERT
    "/",            IDM_ZOOM_FIT,           ASCII,  NOINVERT
    VK_ADD,         IDM_ZOOM_IN,            VIRTKEY, NOINVERT
    VK_PRIOR,       IDM_ZOOM_IN,            VIRTKEY, CONTROL, NOINVERT
    "+",            IDM_ZOOM_IN,            ASCII,  NOINVERT
    VK_HOME,        IDM_ZOOM_NONE,          VIRTKEY, CONTROL, NOINVERT
    VK_MULTIPLY,    IDM_ZOOM_NONE,          VIRTKEY, NOINVERT
    VK_NEXT,        IDM_ZOOM_OUT,           VIRTKEY, CONTROL, NOINVERT
    VK_SUBTRACT,    IDM_ZOOM_OUT,           VIRTKEY, NOINVERT
    "-",            IDM_ZOOM_OUT,           ASCII,  NOINVERT
END

IDR_VIEW ACCELERATORS
BEGIN
    "C",            IDM_EDIT_COPY,          VIRTKEY, CONTROL, NOINVERT
