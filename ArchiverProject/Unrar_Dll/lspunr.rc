IDD_NEXTRAR DIALOGEX 0, 0, 331, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RARファイルの解凍"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_SEARCH,IDC_STATIC,7,7,20,20
    LTEXT           "解凍に必要なボリュームファイルが見つかりません。\nファイルの存在する場所をもう一度指定し直すか、メディアの入れ替えをおこなってください。",IDC_STATIC,35,9,289,20
    LTEXT           "ボリューム名:",IDC_STATIC,7,41,45,8
    LTEXT           "",IDC_RARFILE,54,41,270,8
    LTEXT           "新しい名前:",IDC_STATIC,7,55,46,8
    EDITTEXT        IDC_PATH,54,53,226,14,ES_AUTOHSCROLL
    PUSHBUTTON      "参照(&B)...",IDC_BROWSE,282,53,41,14
    DEFPUSHBUTTON   "OK",IDOK,112,84,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,169,84,50,14
END

IDD_UNPACK DIALOGEX 0, 0, 298, 57
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "RARファイルを操作しています..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "キャンセル",IDCANCEL,247,36,44,14
    CONTROL         "",IDC_METER,"msctls_progress32",0x0,7,37,235,12
    LTEXT           "書庫名:",IDC_STATIC,7,7,41,8
    LTEXT           "",IDC_TITLE,55,7,236,8
    LTEXT           "",IDC_TEXT,55,18,236,8
    LTEXT           "",IDC_MESSAGE,7,18,41,8
END

IDD_REPLACE DIALOGEX 38, 17, 325, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ファイルの置き換え"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_REPLACE,IDC_STATIC,7,7,21,20
    LTEXT           "同名のファイルが存在しています。",IDC_STATIC,35,13,122,8
    LTEXT           "",IDC_SRCNAME,7,32,224,8,SS_NOPREFIX
    LTEXT           "から",IDC_STATIC,236,32,18,8
    LTEXT           "",IDC_SRCPROP,26,44,197,18,SS_NOPREFIX
    LTEXT           "",IDC_DSTNAME,7,70,224,8,SS_NOPREFIX
    LTEXT           "へ",IDC_STATIC,236,70,18,8
    LTEXT           "",IDC_DSTPROP,26,82,197,18,SS_NOPREFIX
    GROUPBOX        "対処方法",IDC_STATIC,7,110,225,32
    CONTROL         "新しい時刻のみ(&T)",IDC_NEWONLY,"Button",BS_AUTORADIOBUTTON,23,124,72,10
    CONTROL         "上書き(&O)",IDC_OVERWRITE,"Button",BS_AUTORADIOBUTTON,108,124,52,10
    CONTROL         "無視(&I)",IDC_IGNORE,"Button",BS_AUTORADIOBUTTON,170,124,39,10
    DEFPUSHBUTTON   "OK",IDOK,266,7,52,14
    PUSHBUTTON      "以降全て(&A)",IDC_YESTOALL,266,24,52,14
    PUSHBUTTON      "キャンセル",IDCANCEL,266,57,52,14
END

IDD_PATHTREAT DIALOGEX 38, 17, 286, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "パスの取り扱い"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "指定した場所以外へファイルが解凍される可能性があります。\n以下から処理を選択してください。",IDC_STATIC,7,6,198,16
    CONTROL         "エラー終了(&E)",IDC_TREAT_ERROR,"Button",BS_AUTORADIOBUTTON,23,33,135,10
    CONTROL         "そのまま解凍(&X)",IDC_TREAT_EXTRACT,"Button",BS_AUTORADIOBUTTON,23,48,135,10
    CONTROL         "このファイルを無視(&I)",IDC_TREAT_IGNORE,"Button",BS_AUTORADIOBUTTON,23,63,135,10
    CONTROL         "ファイルからパスを除外して解凍(&S)",IDC_TREAT_STRIPPATH,"Button",BS_AUTORADIOBUTTON,23,78,135,10
    CONTROL         "相対パスに変換して解凍(&R)",IDC_TREAT_RELATIVE,"Button",BS_AUTORADIOBUTTON,23,93,135,10
    DEFPUSHBUTTON   "OK",IDOK,228,6,52,14
    PUSHBUTTON      "以降全て(&A)",IDC_YESTOALL,228,22,52,14
    PUSHBUTTON      "キャンセル",IDCANCEL,228,49,52,14
END

