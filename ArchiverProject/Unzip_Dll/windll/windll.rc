/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PASSWORD DIALOGEX 0, 0, 201, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "パスワードの入力"
FONT 8, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    LTEXT           "解凍するにはパスワードが必要です。",IDC_STATIC,31,9,163,8
    LTEXT           "",IDC_TEXT,31,20,163,8
    LTEXT           "パスワード(&P):",IDC_STATIC,7,38,43,8
    EDITTEXT        IDC_EDIT,53,36,141,14,ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,44,59,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,107,59,50,14
    ICON            IDI_PASSWORD,IDC_STATIC,7,7,21,20
END

IDD_RELAY DIALOGEX 0, 0, 299, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZIP書庫の解凍"
FONT 8, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    PUSHBUTTON      "キャンセル",IDCANCEL,242,52,50,14
    LTEXT           "",IDC_FROM,34,12,215,8
    LTEXT           "",IDC_FILE,74,34,208,8
    LTEXT           "解凍中...",IDC_STATIC,34,34,34,8
    ICON            IDI_UNZIP,IDC_STATIC,7,7,21,20
    CONTROL         "",IDC_METER,"msctls_progress32",0x0,7,54,230,12
END

IDD_REPLACE DIALOGEX 0, 0, 238, 99
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ファイルの上書き確認"
FONT 8, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    LTEXT           "",IDC_TEXT,36,8,195,8
    LTEXT           "このファイルは既に存在しています。",IDC_STATIC,36,18,135,8
    CONTROL         "既存ファイルを上書きする(&O)",IDC_REPLACE,"Button",BS_AUTORADIOBUTTON,24,50,129,10
    CONTROL         "ファイルを上書きせず無視する(&I)",IDC_IGNORE,"Button",BS_AUTORADIOBUTTON,24,63,129,10
    DEFPUSHBUTTON   "OK",IDOK,181,37,50,14
    PUSHBUTTON      "以降全て(&A)",IDC_OKALL,181,54,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,181,78,50,14
    GROUPBOX        "対処方法",IDC_STATIC,11,35,159,47,WS_GROUP
    ICON            IDI_REPLACE,IDC_STATIC,7,7,21,20
END


