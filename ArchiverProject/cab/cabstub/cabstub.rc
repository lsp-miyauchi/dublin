IDD_RELAY DIALOGEX 0, 0, 214, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "解凍しています..."
FONT 9, "ＭＳ Ｐゴシック", 400, 0, 0x80
BEGIN
    CONTROL         "Progress1",IDC_METER,"msctls_progress32",0x0,6,35,202,12
    LTEXT           "",IDC_TITLE,32,11,174,8
    ICON            IDR_APP,IDC_STATIC,6,6,18,21
END

IDD_EXTRACTTO DIALOGEX 0, 0, 270, 103
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "キャビネット ファイルの解凍"
FONT 9, "ＭＳ Ｐゴシック", 400, 0, 0x80
BEGIN
    ICON            IDR_APP,IDC_STATIC,7,7,18,21
    LTEXT           "解凍します。",IDC_TITLE_EXTRACT,35,8,228,18
    LTEXT           "解凍先のフォルダ(&F):",IDC_STATIC,7,40,189,8
    EDITTEXT        IDC_PATH,7,51,256,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "解凍",IDOK,67,82,60,14
    PUSHBUTTON      "キャンセル",IDCANCEL,141,82,60,14
END

IDD_QUERYCOPY DIALOGEX 0, 0, 206, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ファイルの置き換え"
FONT 9, "ＭＳ Ｐゴシック", 400, 0, 0x80
BEGIN
    LTEXT           "同名ファイルが存在します。",IDC_STATIC,7,7,90,8
    LTEXT           "",IDC_TEXT,7,18,192,8
    GROUPBOX        "対処方法",IDC_STATIC,7,32,122,48
    CONTROL         "無視(&I)",IDC_ACTION_IGNORE,"Button",BS_AUTORADIOBUTTON,25,47,36,10
    CONTROL         "上書き(&O)",IDC_ACTION_OVERWRITE,"Button",BS_AUTORADIOBUTTON,25,61,45,10
    DEFPUSHBUTTON   "OK",IDOK,139,32,60,14
    PUSHBUTTON      "以降全て(&A)",IDC_YESALL,139,48,60,14
    PUSHBUTTON      "キャンセル",IDCANCEL,139,67,60,14
END


