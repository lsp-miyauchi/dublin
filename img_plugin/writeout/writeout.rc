IDD_EXPORT_JPEG DIALOGEX 0, 0, 370, 198
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JPEG設定"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "画像(&G)",IDC_STATIC,7,7,153,64
    CONTROL         "クオリティ(&Q)",IDC_SLIDER,"LSCTrack",WS_TABSTOP,16,21,133,10
    LTEXT           "←低画質",IDC_STATIC,16,33,40,8
    RTEXT           "高画質→",IDC_STATIC,109,33,40,8
    CONTROL         "スムージング(&M)",IDC_SMOOTH,"LSCTrack",WS_TABSTOP,16,48,133,10
    GROUPBOX        "形式(&F)",IDC_STATIC,7,77,153,54,WS_GROUP
    CONTROL         "標準(&S)",IDC_JPGSTANDARD,"Button",BS_AUTORADIOBUTTON,28,90,101,10
    CONTROL         "ベースライン最適化(&B)",IDC_JPGBASELINE,"Button",BS_AUTORADIOBUTTON,28,102,101,10
    CONTROL         "プログレッシブ(&P)",IDC_JPGPROGRESSIVE,"Button",BS_AUTORADIOBUTTON,28,114,101,10
    DEFPUSHBUTTON   "OK",IDOK,28,177,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,90,177,50,14
    CONTROL         "",IDC_PREVIEW,"LSCZoomView",WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | 0x2,169,7,194,153,WS_EX_CLIENTEDGE
    CTEXT           "",IDC_INFO,181,163,89,10,SS_CENTERIMAGE | SS_SUNKEN | NOT WS_GROUP
    CONTROL         "",IDC_SIGNAL,"LSCSignal",0x0,169,163,10,10
    PUSHBUTTON      "+",IDC_ZOOMIN,307,163,10,10
    PUSHBUTTON      "-",IDC_ZOOMOUT,353,163,10,10
    CTEXT           "100%",IDC_POWER,318,164,32,8,NOT WS_GROUP
