IDD_SETUP DIALOGEX 0, 0, 357, 166
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "動作環境の設定"
FONT 8, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    GROUPBOX        "デフォルト解凍先の設定(&X)",IDC_STATIC,6,6,193,56
    LTEXT           "フォルダ(&F):",IDC_STATIC,13,22,41,8
    CONTROL         "",IDC_EDIT,"LSCSearchPath",WS_BORDER | WS_TABSTOP,13,33,178,14
    GROUPBOX        "配色(&C)",IDC_STATIC,6,73,192,87
    LTEXT           "通常のとき：",IDC_STATIC,13,90,68,8
    CONTROL         "ABCサンプル",IDC_COL_NORMAL,"LSCRect",WS_TABSTOP | 0x400,22,99,63,14
    CONTROL         "テキスト(&T)",IDC_BTN_TEXT,"LSCFlatButton",WS_TABSTOP | 0x110,88,99,50,14
    CONTROL         "背景(&B)",IDC_BTN_BACK,"LSCFlatButton",WS_TABSTOP | 0x110,139,99,50,14
    LTEXT           "選択されたとき：",IDC_STATIC,13,120,68,8
    CONTROL         "ABCサンプル",IDC_COL_SELECT,"LSCRect",WS_TABSTOP | 0x400,22,130,63,14
    CONTROL         "テキスト(&S)",IDC_BTN_RTEXT,"LSCFlatButton",WS_TABSTOP | 0x110,88,130,50,14
    CONTROL         "背景(&R)",IDC_BTN_RBACK,"LSCFlatButton",WS_TABSTOP | 0x110,139,130,50,14
    GROUPBOX        "表示や操作(&L)",IDC_STATIC,207,6,143,97
    CONTROL         "小文字で表示(&U)",IDC_OPLOWER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,219,23,119,10
    CONTROL         "グリッドを表示(&G)",IDC_OPGRID,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,219,37,119,10
    CONTROL         "サイズをKB単位で表示(&K)",IDC_OPSIZEKB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,219,51,119,10
    CONTROL         "マウスでホットトラッキング(&H)",IDC_OPHOTTRACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,219,80,115,10
    CONTROL         "1行おきに背景色を変える(&Y)",IDC_OPREPCHECKER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,219,65,107,10
    DEFPUSHBUTTON   "OK",IDOK,224,139,65,14
    PUSHBUTTON      "キャンセル",IDCANCEL,301,139,50,14
END

IDD_NEWARC DIALOGEX 0, 0, 243, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新規書庫の作成"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    ICON            IDI_NEWARC,IDC_STATIC,7,7,21,20
    LTEXT           "新しい書庫ファイルを作成します。\n作成する書庫ファイル名を指定してください。",IDC_STATIC,31,9,140,23
    LTEXT           "ファイル名(&F):",IDC_STATIC,7,43,58,8
    CONTROL         "",IDC_EDIT,"LSCSearchPath",WS_BORDER | WS_TABSTOP,7,54,229,14
    GROUPBOX        "書庫の種類(&T)",IDC_STATIC,7,79,143,51,WS_GROUP
    CONTROL         "LZH書庫(&L)",IDC_LZH,"Button",BS_AUTORADIOBUTTON,24,94,50,10
    CONTROL         "ZIP書庫(&Z)",IDC_ZIP,"Button",BS_AUTORADIOBUTTON,24,108,48,10
    DEFPUSHBUTTON   "OK",IDOK,186,97,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,186,116,50,14
END


