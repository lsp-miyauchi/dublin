/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_ARCVIEW             ICON                    "res\\archive_view.ico"

IDI_NEWARC              ICON                    "res\\archive.ico"

IDI_CRYPTED             ICON                    "res\\crypted.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_ARCVIEW MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "開く(&O)\tCtrl+O",              IDM_FILE_OPEN
        MENUITEM SEPARATOR
//        MENUITEM "書庫の新規作成(&N)\tCtrl+N",         IDM_NEW
        MENUITEM "自己解凍書庫の作成(&M)\tCtrl+S",       IDM_MAKESFX
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&C)\tEsc",                IDM_CLOSE
    END
    POPUP "操作(&O)"
    BEGIN
        MENUITEM "解凍(&U)\tCtrl+Enter",          IDM_EXTRACT
        MENUITEM "全て解凍(&A)\tAlt+Enter",         IDM_EXTRACTALL
        MENUITEM "内容を表示(&V)\tShift+Enter",      IDM_VIEW
        MENUITEM "内容をバイナリダンプ(&B)\tCtrl+Alt+Enter", IDM_BDUMP
        MENUITEM "アプリケーションから開く(&O)\tEnter",     IDM_OPEN
        MENUITEM "名前の変更(&R)",                   IDM_RENAME
        MENUITEM SEPARATOR
        MENUITEM "コピー(&C)\tCtrl+C",             IDM_CLIP
        MENUITEM "削除(&D)\tDel",                 IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&A)\tCtrl+A",           IDM_SELALL
        MENUITEM "選択の切り替え(&I)\tShift+Home",     IDM_SELREV
    END
    POPUP "設定(&S)"
    BEGIN
        MENUITEM "フォルダツリー(&F)\tCtrl+F",         IDM_VIEW_FOLDER
        MENUITEM SEPARATOR
        POPUP "アイコン(&I)"
        BEGIN
            MENUITEM "大きいアイコン(&G)",                 IDM_ICON_LARGE
            MENUITEM "一覧(&L)",                      IDM_ICON_LIST
            MENUITEM "詳細(&D)",                      IDM_ICON_REPORT
        END
        POPUP "ソート方法(&T)"
        BEGIN
            MENUITEM "昇順(&U)",                      IDM_SORT_UP
            MENUITEM "降順(&D)",                      IDM_SORT_DOWN
            MENUITEM SEPARATOR
            MENUITEM "名前(&N)",                      IDM_SORT_NAME
            MENUITEM "拡張子(&E)",                     IDM_SORT_EXT
            MENUITEM "サイズ(&S)",                     IDM_SORT_SIZE
            MENUITEM "更新日付(&T)",                    IDM_SORT_TIME
            MENUITEM "属性(&A)",                      IDM_SORT_ATTR
            MENUITEM "パス名(&P)",                     IDM_SORT_PATH
            MENUITEM SEPARATOR
            MENUITEM "ソートしない(&U)",                  IDM_SORT_NONE
        END
        MENUITEM SEPARATOR
        MENUITEM "動作環境(&S)...",                 IDM_SETUP
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                     ID_HELP
        MENUITEM "アーカイバーについて(&A)...",           ID_APP_ABOUT
    END
END

IDR_POPUP MENU
BEGIN
    POPUP "POPUP"
    BEGIN
        MENUITEM "開く(&O)",                      IDM_OPEN
        MENUITEM "内容を表示(&V)",                   IDM_VIEW
        MENUITEM "解凍(&U)",                      IDM_EXTRACT
        MENUITEM SEPARATOR
        MENUITEM "削除(&D)",                      IDM_DELETE
    END
END


