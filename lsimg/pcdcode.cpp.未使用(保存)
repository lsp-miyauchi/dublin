#include "libpcd\pcd.h"

extern "C"
HDIB WINAPI imgPcdLoadEx(LPCTSTR pszFile, int subimage)
{
	// subimage	ÉTÉCÉY			ÉsÉNÉZÉãêî		égópÉÅÉÇÉäêî 
	// 1		1/16BASE		128Å~192		72KB
	// 2		1/4BASE			256Å~384		288KB
	// 3		BASE			512Å~768		1.2MB
	// 4		4BASE			1024Å~1536		4.5MB
	// 5		16BASE			2048Å~3072		18MB
	// 6		64BASE			4096Å~6144		72MB
	// Determine resolution by subimage specification.

	if (subimage < 1 || subimage > 6) return NULL;

	PCD_IMAGE pcd;
	if (pcd_open(&pcd, pszFile) != 0) return NULL;
	int rot = pcd_get_rot(&pcd, 0);
	subimage = min(subimage, pcd_get_maxres(&pcd));

	int width = 0, height = 0;
	if (pcd_select(&pcd, subimage, 0, rot, &width, &height) == -1) {
		pcd_close(&pcd);
		return NULL;
    }

	mif image(width, height, 24);
	if (pcd_decode(&pcd ) == -1) {
		pcd_close(&pcd);
		return NULL;
    }

	BYTE* data = (BYTE*)malloc(width * 3);
    for (int y = 0; y < height; y++) {
		if (pcd_get_image_line(&pcd, y, data) == -1) {
			pcd_close(&pcd);
			return NULL;
	    }

		RGBA* p = image.pos(0, y);
		BYTE* q = data;
		for (int x = 0; x < width; x++) {
			p->red = *q++;
			p->green = *q++;
			p->blue = *q++;
			p++;
		}
    }
	pcd_close(&pcd);
	free(data);

	return image.createdib();
}

extern "C"
HDIB WINAPI imgPcdLoad(LPCTSTR pszFile)
{
	return imgPcdLoadEx(pszFile, 3);
}

