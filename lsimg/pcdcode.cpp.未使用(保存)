typedef struct tagPCDTABLE
{
	UINT length;
	UINT sequence;
	BYTE key;
	UINT mask;
} PCDTABLE;


void Upsample(int width, int height, int scaled_width, BYTE* pixels)
{
	register int x, y;
	register BYTE *p, *q, *r;

	// Create a new image that is a integral size greater than an existing one.
	for (y = 0; y < height; y++) {
		p = pixels + (height - 1 - y) * scaled_width + (width - 1);
		q = pixels + ((height - 1 - y) << 1) * scaled_width + ((width - 1) << 1);
		*q = *p;
		*(q + 1) = *p;
		for (x = 1; x < width; x++) {
			p--;
			q -= 2;
			*q = *p;
			*(q + 1) = (((int)*p) + ((int)*(p + 1)) + 1) >> 1;
		}
	}

	for (y = 0; y < height - 1; y++) {
		p = pixels + (y << 1) * scaled_width;
		q = p + scaled_width;
		r = q + scaled_width;
		for (x = 0; x < width - 1; x++) {
			*q = (((int)*p) + ((int)*r) + 1) >> 1;
			*(q + 1) = (((int)*p) + ((int)*(p + 2)) + ((int)*r) + ((int)*(r + 2)) + 2) >> 2;
			q += 2;
			p += 2;
			r += 2;
		}
		*q++ = (((int)*p++) + ((int)*r++) + 1) >> 1;
		*q++ = (((int)*p++) + ((int)*r++) + 1) >> 1;
	}
	p = pixels + (2 * height - 2) * scaled_width;
	q = pixels + (2 * height - 1) * scaled_width;
	for (x = 0; x < width; x++) {
		*q++ = *p++;
		*q++ = *p++;
	}
}

BOOL PCDDecodeImage(filemap& fm, mif& image, BYTE* luma, BYTE* chroma1, BYTE* chroma2)
{
#define ISSYNC  ((accumulator & 0xffffff00) == 0xfffffe00)
#define PCDGETBITS(n) \
{ \
	accumulator = (accumulator << n) & 0xffffffff; \
	bits -= n; \
	while (bits <= 24) { \
		if (p >= (buffer + 0x800)) { \
			fm.read(buffer, 0x800); \
			p = buffer; \
		} \
		accumulator |= ((UINT)(*p) << (24 - bits)); \
		bits += 8; \
		p++; \
	} \
	if (fm.m_size <= fm.seek(0, SEEK_CUR)) \
		break; \
}

	int count, length, row;
	PCDTABLE* pcd_table[3];
	register int i, j;
	register PCDTABLE* r;
	register BYTE* range_limit;
	register BYTE *p, *q;
	BYTE* buffer;
	UINT accumulator, bits, pcd_length[3], plane;

	buffer = (BYTE*)malloc(0x800 * sizeof(BYTE));
	if (buffer == NULL)
		return FALSE;

	accumulator = 0;
	bits = 32;
	p = buffer + 0x800;
	for (i = 0; i < (image.m_width > 1536 ? 3 : 1); i++) {
		PCDGETBITS(8);
		length = (accumulator & 0xff) + 1;
		pcd_table[i] = (PCDTABLE*)malloc(length * sizeof(PCDTABLE));
		if (pcd_table[i] == NULL) {
			free(buffer);
			return FALSE;
		}

		r = pcd_table[i];
		for (j = 0; j < length; j++) {
			PCDGETBITS(8);
			r->length = (accumulator & 0xff) + 1;
			if (r->length > 16) {
				free(buffer);
				return FALSE;
			}
			PCDGETBITS(16);
			r->sequence = (accumulator & 0xffff) << 16;
			PCDGETBITS(8);
			r->key = accumulator & 0xff;
			r->mask = (~((((UINT)1) << (32 - r->length)) - 1));
			r++;
		}
		pcd_length[i] = length;
	}

	// Initialize range limits.
	range_limit = (BYTE*)malloc(3 * (MAXRGB + 1));
	if (range_limit == NULL) {
		free(buffer);
		return FALSE;
	}

	for (i = 0; i <= MAXRGB; i++) {
		range_limit[i] = 0;
		range_limit[i + (MAXRGB + 1)] = (BYTE)i;
		range_limit[i + (MAXRGB + 1) * 2] = MAXRGB;
	}
	range_limit += (MAXRGB + 1);

	// Search for Sync byte.
	do {
		PCDGETBITS(16)
	} while (0);
	do {
		PCDGETBITS(16)
	} while (0);
	while ((accumulator & 0x00fff000) != 0x00fff000)
		PCDGETBITS(8);
	while (!ISSYNC)
		PCDGETBITS(1);

	// Recover the Huffman encoded luminance and chrominance deltas.
	count = 0;
	length = 0;
	plane = 0;
	q = luma;
	for ( ; ; ) {
		if (ISSYNC) {
			// Determine plane and row number.
			PCDGETBITS(16);
			row = ((accumulator >> 9) & 0x1fff);
			if (row == image.m_height)
				break;

			PCDGETBITS(8);
			plane = accumulator >> 30;
			PCDGETBITS(16);
			switch (plane) {
				case 0:
					q = luma + row * image.m_width;
					count = image.m_width;
					break;

				case 2:
					q = chroma1 + (row >> 1) * image.m_width;
					count = image.m_width >> 1;
					plane--;
					break;

				case 3:
					q = chroma2 + (row >> 1) * image.m_width;
					count = image.m_width >> 1;
					plane--;
					break;

				default:
					return FALSE;
			}
			length = pcd_length[plane];
			continue;
		}

		// Decode luminance or chrominance deltas.
		r = pcd_table[plane];
		for (i = 0; (i < length && (accumulator & r->mask) != r->sequence); i++)
			r++;

		if (r == NULL) {
			while ((accumulator & 0x00fff000) != 0x00fff000)
				PCDGETBITS(8);
			while (!ISSYNC)
				PCDGETBITS(1);
			continue;
		}

		if (r->key < 128)
			*q = range_limit[(int)*q + (int)r->key];
		else
			*q = range_limit[(int)*q + (int)r->key - 256];
		q++;
		PCDGETBITS(r->length);
		count--;
	}

	// Free memory.
	for (i = 0; i < (image.m_width > 1536 ? 3 : 1); i++)
		free(pcd_table[i]);
	range_limit -= (MAXRGB + 1);
	free(range_limit);
	free(buffer);

	return TRUE;
}

