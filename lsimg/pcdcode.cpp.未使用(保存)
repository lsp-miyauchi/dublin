		case 4:
		case 8:
			for (i = 0; i < image.m_colors; i++) {
				x = image.m_map[i].red;
				y = image.m_map[i].green;
				z = image.m_map[i].blue;
				v = DOWNSHIFT(rtb[x + R] + gtb[y + R] + btb[z + R]);
				image.m_map[i].red = range_limit[v];
				v = DOWNSHIFT(rtb[x + G] + gtb[y + G] + btb[z + G]);
				image.m_map[i].green = range_limit[v];
				v = DOWNSHIFT(rtb[x + B] + gtb[y + B] + btb[z + B]);
				image.m_map[i].blue = range_limit[v];
			}
			p = image.m_pixels;
			for (i = 0; i < image.m_packets; i++) {
				x = p->red;
				y = p->green;
				z = p->blue;
				v = DOWNSHIFT(rtb[x + R] + gtb[y + R] + btb[z + R]);
				p->red = range_limit[v];
				v = DOWNSHIFT(rtb[x + G] + gtb[y + G] + btb[z + G]);
				p->green = range_limit[v];
 				v = DOWNSHIFT(rtb[x + B] + gtb[y + B] + btb[z + B]);
 				p->blue = range_limit[v];
				p++;
			}
			break;
	}

	free(range_table);
	free(basetable);
}

static HDIB pcd_load_core(filemap& fm, UINT subimage)
{
	long offset;
	register int i;
	register RGBA* p;
	register BYTE *c1, *c2, *y;
	BYTE *chroma1, *chroma2, *luma;

	// Determine if this is a PCD file.
	BYTE* header = (BYTE*)malloc(3 * 0x800 * sizeof(BYTE));
	if (header == NULL) {
		return NULL;
	}

	if (fm.read(header, 3 * 0x800) != 3 * 0x800) {
		free(header);
		return NULL;
	}

	UINT rotate = header[0x0e02] & 0x03;
	UINT number_images = (header[10] << 8) | header[11];
	free(header);

	int width = 192 << (subimage - 1);
	int height = 128 << (subimage - 1);

	mif image(width, height, 24);
	chroma1 = (BYTE*)malloc(image.m_packets + 1);
	chroma2 = (BYTE*)malloc(image.m_packets + 1);
	luma = (BYTE*)malloc(image.m_packets + 1);
	if (!chroma1 || !chroma2 || !luma) {
		return NULL;
	}

	// Advance to image data.
	offset = 93;
	if (subimage == 2)
		offset = 20;
	else if (subimage <= 1)
		offset = 1;
	fm.seek(offset * 0x800, SEEK_CUR);

	// Read interleaved image.
	y = luma;
	c1 = chroma1;
	c2 = chroma2;
	for (i = 0; i < height; i += 2) {
		fm.read(y, width);
		y += image.m_width;

		fm.read(y, width);
		y += image.m_width;

		fm.read(c1, width >> 1);
		c1 += image.m_width;

		fm.read(c2, width >> 1);
		c2 += image.m_width;
	}

	if (subimage >= 4) {
		// Recover luminance deltas for 1536x1024 image.
		Upsample(768, 512, image.m_width, luma);
		Upsample(384, 256, image.m_width, chroma1);
		Upsample(384, 256, image.m_width, chroma2);
		image.m_height = 1024;

		fm.seek(4 * 0x800, SEEK_CUR);
		UINT status = PCDDecodeImage(fm, image, luma, chroma1, chroma2);
		if (subimage >= 5 && status) {
			// Recover luminance deltas for 3072x2048 image.
			Upsample(1536, 1024, image.m_width, luma);
			Upsample(768, 512, image.m_width, chroma1);
			Upsample(768, 512, image.m_width, chroma2);
			image.m_height = 2048;
			offset = fm.seek(0, SEEK_CUR) / 0x800 + 12;
			fm.seek(offset * 0x800, SEEK_SET);
			status = PCDDecodeImage(fm, image, luma, chroma1, chroma2);
			if (subimage >= 6 && status) {
				// Recover luminance deltas for 6144 x 4096 image (vaporware).
				Upsample(3072, 2048, image.m_width, luma);
				Upsample(1536, 1024, image.m_width, chroma1);
				Upsample(1536, 1024, image.m_width, chroma2);
				image.m_height = 4096;
			}
		}
	}

	Upsample(image.m_width >> 1, image.m_height >> 1, image.m_width, chroma1);
	Upsample(image.m_width >> 1, image.m_height >> 1, image.m_width, chroma2);

	// Transfer luminance and chrominance channels.
	p = image.m_pixels;
	y = luma;
	c1 = chroma1;
	c2 = chroma2;
	for (i = 0; i < image.m_packets; i++) {
		p->red = *y++;
		p->green = *c1++;
		p->blue = *c2++;
		p++;
	}
	free(chroma2);
	free(chroma1);
	free(luma);

//@	if (Latin1Compare(image_info->magick,"PCDS") == 0)
//@		TransformRGBImage(pImage, COLSPC_SRGB);
//@	else
		TransformRGBImage(image, COLSPC_YCC);

	if (rotate == 1 || rotate == 3)
		image.rotate(rotate == 1);
	return image.createdib();
}

