IDD_REGNUM_DIALOG DIALOGEX 0, 0, 222, 161
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Regnum"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "プレフィクス(&P):",IDC_STATIC,7,20,51,8
