//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "開く(&O)",                      IDM_FILE_OPEN
        MENUITEM "コピー(&C)",                     IDM_FILE_COPY
        MENUITEM "移動(&M)",                      IDM_FILE_MOVE
        POPUP "新規作成(&N)"
        BEGIN
            MENUITEM "フォルダの新規作成(&M)...",            IDM_FILE_MKDIR
            MENUITEM "ショートカットの作成(&U)...",           IDM_FILE_SHORTCUT
            MENUITEM "空ファイルの作成(&E)...",             IDM_FILE_NEWFILE
            MENUITEM "新しいブリーフ ケースの作成(&R)...",       IDM_DIR_MAKEBRIEFCASE
            MENUITEM "(なし)",                        IDM_SHLNEW_EMPTY
        END
        MENUITEM SEPARATOR
        MENUITEM "属性の変更(&I)...",                IDM_FILE_ATTRIB
        MENUITEM "名前の変更(&R)",                   IDM_FILE_RENAME
        POPUP "名前の置換(&L)"
        BEGIN
            MENUITEM "拡張子の一括変更(&T)...",             IDM_FILE_RENEXT
            MENUITEM "連番で名前変更(&S)...",              IDM_FILE_SERIESNAME
            MENUITEM "名前の一括置換(&L)...",              IDM_FILE_REPNAMES
            MENUITEM "大文字小文字の一括変換(&C)...",          IDM_FILE_CHGCAPS
        END
        MENUITEM SEPARATOR
        MENUITEM "削除(&D)",                      IDM_FILE_DELETE
        MENUITEM "一括削除(&F)...",                 IDM_FILE_FILTERDEL
        MENUITEM "シュレッダ(&Z)...",                IDM_FILE_SHRED
        MENUITEM SEPARATOR
        MENUITEM "送る(&S)...\tCtrl+Shift+Enter", IDM_FILE_SENDTO
        MENUITEM "プロパティ(&P)\tAlt+Enter",        IDM_FILE_PROPERTY
        MENUITEM SEPARATOR
        MENUITEM "Windows ターミナル(&P)",           IDM_TOOL_SHELL
        MENUITEM "コマンド プロンプトを開く(&M)",           IDM_TOOL_MSDOS
        MENUITEM "名前を指定して実行(&E)...",            IDM_FILE_EXECUTE
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tAlt+F4",              ID_APP_EXIT
        MENUITEM "すべて終了(&Q)",                   ID_APP_EXITALL
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "オブジェクトの切り取り(&X)\tCtrl+Del",   IDM_EDIT_CUT
        MENUITEM "オブジェクトのコピー(&C)\tCtrl+Ins",    IDM_EDIT_COPY
        MENUITEM "オブジェクトの貼付け(&P)\tShift+Ins",   IDM_EDIT_PASTE
        MENUITEM "ショートカットの貼付け(&S)\tCtrl+Shift+Ins", IDM_EDIT_PASTESHORTCUT
        MENUITEM SEPARATOR
        POPUP "パス名をコピー(&O)"
        BEGIN
            MENUITEM "名前のみコピー(&N)",                 IDM_COPY_NAMEONLY
            MENUITEM "詳細情報とともにコピー(&D)",             IDM_COPY_DETAIL
            MENUITEM "フルパス名をコピー(&T)",               IDM_COPY_FULLNAME
            MENUITEM "フルパス名を短い名前でコピー(&S)",          IDM_COPY_SHORTNAME
            MENUITEM "フルパス名でUNC名をコピー(&U)",          IDM_COPY_UNCNAME
        END
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&U)",                   IDM_FILE_SELALL
        MENUITEM "選択の反転(&R)",                   IDM_FILE_SELINVERT
        MENUITEM "フィルタ(&F)...\t*",              IDM_VIEW_WILDCARD
        MENUITEM "フィルタを解除(&L)",                 IDM_VIEW_RELEASEFILTER
        MENUITEM "一括選択(&A)...\tCtrl+*",         IDM_FILE_MASKSELECT
        MENUITEM SEPARATOR
        MENUITEM "関連付け(&A)...",                 IDM_FILE_ASSOCIATE
    END
    POPUP "フォルダ(&D)"
    BEGIN
        MENUITEM "ホーム(&H)\tAlt+Home",           IDM_DIR_HOME
        MENUITEM "指定のフォルダを開く(&V)...",           IDM_DIR_SELECT
        MENUITEM "このフォルダをしおりへ登録(&F)",           IDM_DIR_ADDFAVORITE
        MENUITEM SEPARATOR
        MENUITEM "検索(&S)...",                   IDM_DIR_SEARCH
        POPUP "システム フォルダ(&I)"
        BEGIN
            MENUITEM "(なし)",                        IDM_SPFL_EMPTY
        END
        MENUITEM SEPARATOR
        MENUITEM "ごみ箱を空にする(&B)",                IDM_DIR_EMPTYRECYCLEBIN
        MENUITEM SEPARATOR
        MENUITEM "フォルダの同期(&Y)...",              IDM_DIR_SYNC
        POPUP "フォルダ同期リスト(&T)"
        BEGIN
            MENUITEM "同期リスト フォルダを開く(&F)",           IDM_DIR_OPENSYNCFOLDER
            MENUITEM "フォルダ同期リストの作成(&P)...",         IDM_DIR_SCRIPTSYNC
            MENUITEM SEPARATOR
            MENUITEM "（なし）",                        IDM_SSYNC_START
        END
        MENUITEM SEPARATOR
        MENUITEM "ひとつ上の階層へ(&U)\tBS",            IDM_DIR_UPDIR
        MENUITEM "履歴(&H)\tAlt+↑",               IDM_DIR_HISTORY
        MENUITEM "ひとつ前のフォルダ(&P)\tAlt+←",        IDM_DIR_PREV
        MENUITEM "次のフォルダ(&N)\tAlt+→",           IDM_DIR_NEXT
        MENUITEM SEPARATOR
        MENUITEM "デスクトップ以下をツリー表示(&D)",          IDM_VIEW_DESKTOPTREE
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "ファイル情報(&I)...",               IDM_VIEW_FILEINFO
        MENUITEM "ファイル容量の詳細(&E)...",            IDM_VIEW_FILESIZE
        MENUITEM "ドライブ情報(&R)...",               IDM_VIEW_DRIVEINFO
        MENUITEM SEPARATOR
        POPUP "ツールバー(&B)"
        BEGIN
            MENUITEM "(なし)",                        IDW_TBFIRST
            MENUITEM SEPARATOR
            MENUITEM "メニュー バー(&M)",                 IDM_BAR_MENU
            MENUITEM "プロパティ バー(&P)",                IDM_BAR_PROP
            MENUITEM "ソート バー(&O)",                  IDM_BAR_SORT
            MENUITEM "ドライブ バー(&D)",                 IDM_BAR_DRIVE
            MENUITEM "ナビゲーション バー(&N)",              IDM_BAR_NAVI
            MENUITEM "スマート バー(&A)",                 IDM_BAR_SMART
            MENUITEM "ステータス バー(&S)",                IDM_BAR_STAT
            MENUITEM "App スタック(&B)",                IDM_BAR_APPBAR
            MENUITEM "しおり(&F)",                     IDM_BAR_FAVO
            MENUITEM "機能キー(&K)",                    IDM_BAR_FUNCTION
            MENUITEM SEPARATOR
            POPUP "バーの配置など(&G)"
            BEGIN
                MENUITEM "ドライブ バーを横置き(&H)",             IDM_BAR_DRIVE_HORZ
                MENUITEM "ドライブ バーを左側面に縦置き(&V)",         IDM_BAR_DRIVE_VERTLEFT
                MENUITEM "ドライブ バーを右側面に縦置き(&R)",         IDM_BAR_DRIVE_VERTRIGHT
                MENUITEM SEPARATOR
                MENUITEM "ツール バーは大きなアイコンで表示(&E)",       IDM_BAR_LARGEICON
                MENUITEM SEPARATOR
                MENUITEM "ツール バーの整列(&U)...",            IDM_BAR_REPOSITION
                MENUITEM "ツール バーを固定する(&L)...",          IDM_BAR_LOCKREBAR
            END
        END
        MENUITEM SEPARATOR
        POPUP "表示する種類やプロパティ(&P)"
        BEGIN
            MENUITEM "サイズを表示(&I)",                  IDM_VIEW_SIZE
            MENUITEM "更新日付を表示(&E)",                 IDM_VIEW_DATE
            MENUITEM "属性を表示(&A)",                   IDM_VIEW_ATTRIB
            MENUITEM SEPARATOR
            MENUITEM "隠しシステム ファイル・フォルダを表示しない(&S)",  IDM_TYPE_FILESUPERHIDDEN
            MENUITEM "すべての隠しファイル・フォルダを表示しない(&F)",   IDM_TYPE_FILEHIDDEN
            MENUITEM SEPARATOR
            MENUITEM "フォルダを表示しない(&D)",              IDM_TYPE_EXCFOLDER
        END
        POPUP "ソート(&S)"
        BEGIN
            MENUITEM "(なし)",                        IDM_SORT_COL0
            MENUITEM SEPARATOR
            MENUITEM "昇順(&U)",                      IDM_SORT_UP
            MENUITEM "降順(&D)",                      IDM_SORT_DOWN
            MENUITEM SEPARATOR
            MENUITEM "ソートしない(&X)",                  IDM_SORT_NONE
        END
        POPUP "ファイルの表示方法(&M)"
        BEGIN
            MENUITEM "イメージ(&M)",                    IDM_ICON_IMAGE
            MENUITEM "アイコン(&I)",                    IDM_ICON_ICON
            MENUITEM "概要(&O)",                      IDM_ICON_OUTLINE
            MENUITEM "一覧(&N)",                      IDM_ICON_NORMAL
            MENUITEM "詳細(&D)",                      IDM_ICON_REPORT
            MENUITEM SEPARATOR
            MENUITEM "アイコンを大きく表示(&L)",              IDM_ICON_ENLARGE
            MENUITEM "長い名前は短縮する(&L)",               IDM_VIEW_NAMEELLIPSIS
            MENUITEM SEPARATOR
            MENUITEM "ゆとりビュー(&R)",                  IDM_ICON_RELAX
        END
        POPUP "サムネイル サイズ(&H)"
        BEGIN
            MENUITEM "72 x 72",                     IDM_IMAGE_072
            MENUITEM "96 x 96",                     IDM_IMAGE_096
            MENUITEM "128 x 128",                   IDM_IMAGE_128
            MENUITEM "160 x 160",                   IDM_IMAGE_160
            MENUITEM "192 x 192",                   IDM_IMAGE_192
        END
        MENUITEM SEPARATOR
        MENUITEM "基本の表示スタイルを更新(&T)",            IDM_VIEW_SAETDEFAULT
        MENUITEM SEPARATOR
        MENUITEM "ショートカット キー 一覧(&Y)",           IDM_VIEW_KEYMAP
        MENUITEM SEPARATOR
        POPUP "ネットワーク(&N)"
        BEGIN
            MENUITEM "ネットワーク ドライブの割り当て(&N)...",     IDM_NET_CONNECT
            MENUITEM "ネットワーク ドライブの切断(&S)...",       IDM_NET_DISCONNECT
            MENUITEM "ネットワークの場所を追加(&P)...",         IDM_NET_ADDPLACE
        END
    END
    POPUP "ツール(&T)"
    BEGIN
        MENUITEM "ファイル内容を閲覧(&V)...",            IDM_TOOL_VIEWER
        MENUITEM "バイナリ編集(&D)...",               IDM_TOOL_BDUMP
        MENUITEM SEPARATOR
        MENUITEM "エディタで編集(&E)...",              IDM_TOOL_EDITOR
        MENUITEM "ファイルから文字列を検索(&G)",            IDM_TOOL_GREP
        MENUITEM SEPARATOR
        MENUITEM "形式を指定してファイル リストを出力(&L)...",   IDM_EDIT_LISTOUTPUT
        MENUITEM "ハッシュを計算(&H)...",              IDM_TOOL_CALCHASH
        MENUITEM SEPARATOR
        MENUITEM "ファイルを連結(&G)",                 IDM_FILE_MERGE
        MENUITEM "ファイルを分割(&V)",                 IDM_FILE_DIVIDE
        POPUP "書庫ファイルの操作(&H)"
        BEGIN
            MENUITEM "書庫ファイルの作成(&S)...",            IDM_FILE_PACK
            MENUITEM "書庫ファイルの解凍(&T)...",            IDM_FILE_UNPACK
            MENUITEM SEPARATOR
            MENUITEM "書庫の正当性検査(&C)...",             IDM_FILE_CHECKARC
        END
        MENUITEM SEPARATOR
        POPUP "設定(&S)"
        BEGIN
            MENUITEM "ホットキー メニュー(&K)",              IDM_VIEW_HOTKEYMENU
            MENUITEM SEPARATOR
            MENUITEM "ショートカット キー(&Y)...",           IDM_OPTION_KEYMAP
            MENUITEM "ショートカット メニュー(&S)...",         IDM_OPTION_SHORTCUT
            MENUITEM SEPARATOR
            MENUITEM "オプション(&O)...\tAlt+F7",        IDM_OPTION_MISC
            MENUITEM "シェル拡張機能(&X)...",              IDM_OPTION_SHELLEXT
        END
    END
    POPUP "タブ(&B)"
    BEGIN
        MENUITEM "新しいタブ(&T)",                   IDM_TAB_NEW
        MENUITEM SEPARATOR
        POPUP "最近閉じたタブ(&I)"
        BEGIN
            MENUITEM "(なし)",                        IDM_TAB_REOPEN_FIRST
        END
        POPUP "タブ グループ(&G)"
        BEGIN
            MENUITEM "タブ グループを保存(&Q)",              IDM_TAB_SAVEALL
            MENUITEM "保存したタブ グループを開く(&F)",          IDM_TAB_RESTOREALL
            MENUITEM SEPARATOR
            MENUITEM "(なし)",                        IDM_TAB_GROUP_FIRST
        END
        MENUITEM SEPARATOR
        MENUITEM "タブをロック(&L)",                  IDM_TAB_LOCK
        MENUITEM "タブを分離(&E)",                   IDM_TAB_EXPORT
        POPUP "タブをソート(&S)"
        BEGIN
            MENUITEM "作成順(&C)",                     IDM_TAB_SORTDEFAULT
            MENUITEM "参照順(&R)",                     IDM_TAB_SORTREFERENCE
        END
        MENUITEM SEPARATOR
        MENUITEM "前のタブ(&A)\tCtrl+Shift+Tab",    IDM_TAB_PREV
        MENUITEM "次のタブ(&D)\tCtrl+Tab",          IDM_TAB_NEXT
        MENUITEM SEPARATOR
        MENUITEM "他のタブをすべて閉じる(&O)",             IDM_TAB_CLOSE_ANYOTHER
        MENUITEM "左のタブをすべて閉じる(&T)",             IDM_TAB_CLOSE_LEFTSIDE
        MENUITEM "右のタブをすべて閉じる(&G)",             IDM_TAB_CLOSE_RIGHTSIDE
        MENUITEM SEPARATOR
        MENUITEM "タブを閉じる(&T)",                  IDM_TAB_CLOSE
    END
    POPUP "ウィンドウ(&W)"
    BEGIN
        MENUITEM "最新の情報に更新(&R)",                IDM_WINDOW_REFLESH
        MENUITEM SEPARATOR
        MENUITEM "新しいウィンドウ(&W)",                IDM_EXEC_OWN
        MENUITEM SEPARATOR
        MENUITEM "重ねて表示(&C)",                   ID_WINDOW_CASCADE
        MENUITEM "横に並べて表示(&H)",                 ID_WINDOW_TILE_HORZ
        MENUITEM "縦に積んで表示(&V)",                 ID_WINDOW_TILE_VERT
        MENUITEM SEPARATOR
