IDR_MAINFRAME ACCELERATORS
BEGIN
    VK_UP,          IDM_DIR_HISTORY,        VIRTKEY, ALT, NOINVERT
    VK_HOME,        IDM_DIR_HOME,           VIRTKEY, ALT, NOINVERT
    VK_RIGHT,       IDM_DIR_NEXT,           VIRTKEY, ALT, NOINVERT
    VK_LEFT,        IDM_DIR_PREV,           VIRTKEY, ALT, NOINVERT
    "\\",           IDM_DIR_ROOT,           ASCII,  NOINVERT
    VK_BACK,        IDM_DIR_UPDIR,          VIRTKEY, NOINVERT
    VK_INSERT,      IDM_EDIT_COPY,          VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      IDM_EDIT_CUT,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      IDM_EDIT_PASTE,         VIRTKEY, SHIFT, NOINVERT
    VK_INSERT,      IDM_EDIT_PASTESHORTCUT, VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_APPS,        IDM_FILE_CONTEXTMENU,   VIRTKEY, NOINVERT
    VK_MULTIPLY,    IDM_FILE_MASKSELECT,    VIRTKEY, CONTROL, NOINVERT
    VK_RETURN,      IDM_FILE_PROPERTY,      VIRTKEY, ALT, NOINVERT
    VK_RETURN,      IDM_FILE_SENDTO,        VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_F7,          IDM_OPTION_MISC,        VIRTKEY, ALT, NOINVERT
    "*",            IDM_VIEW_WILDCARD,      ASCII,  NOINVERT
    VK_TAB,         IDM_TAB_NEXT,           VIRTKEY, CONTROL, NOINVERT
    VK_TAB,         IDM_TAB_PREV,           VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_TAB,         IDM_WINDOW_NEXT,        VIRTKEY, CONTROL, ALT, NOINVERT
    VK_TAB,         IDM_WINDOW_PREV,        VIRTKEY, SHIFT, CONTROL, ALT, NOINVERT
    "A",            IDM_HOT_NAVIBAR,        VIRTKEY, ALT, NOINVERT
    "+",            IDM_IMAGE_ZOOMIN,       ASCII,  NOINVERT
    "-",            IDM_IMAGE_ZOOMOUT,      ASCII,  NOINVERT
END

IDW_FINDBAR ACCELERATORS
BEGIN
    VK_RETURN,      IDM_FINDER_ENTER,       VIRTKEY, NOINVERT
    VK_RETURN,      IDM_FINDER_SELECT_ENTER, VIRTKEY, SHIFT, NOINVERT
    "N",            IDM_FINDER_NEXT,        VIRTKEY, ALT, NOINVERT
