    VK_UP,          IDM_FINDER_PREV,        VIRTKEY, CONTROL, NOINVERT
    VK_LEFT,        IDM_FINDER_PREV,        VIRTKEY, CONTROL, NOINVERT
    VK_SPACE,       IDM_FINDER_PREV,        VIRTKEY, SHIFT, NOINVERT
    "A",            IDM_FINDER_SELECT,      VIRTKEY, ALT, NOINVERT
