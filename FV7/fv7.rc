        MENUITEM "保存したウィンドウ位置を復帰(&L)",          IDM_WINDOW_COMBINELOAD
        MENUITEM SEPARATOR
        MENUITEM "前のウィンドウ(&P)\tAlt+Ctrl+Shift+Tab", IDM_WINDOW_PREV
        MENUITEM "次のウィンドウ(&N)\tAlt+Ctrl+Tab",   IDM_WINDOW_NEXT
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "目次(&T)",                      ID_HELP_FINDER
        MENUITEM "ユーザ登録について(&U)",               IDM_HELP_SHAREWARE
        POPUP "WEBドキュメント(&W)"
        BEGIN
            MENUITEM "LightShip ホームページ(&H)",        IDM_WEB_HOMEPAGE
            MENUITEM "フィードバックの送信(&F)",              IDM_WEB_FEEDBACK
            MENUITEM "最新バージョンの取得(&N)",              IDM_WEB_DOWNLOAD
        END
