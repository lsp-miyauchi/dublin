IDR_FRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規作成(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "クリップボードを開く(&L)",              ID_FILE_OPENCLIPBOARD
        MENUITEM "保存(&S)\tCtrl+S",              ID_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...",             ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        POPUP "最近開いたファイル"
        BEGIN
            MENUITEM "（なし）",                        ID_FILE_MRU_FILE1, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)",                      ID_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM "やり直す(&R)\tCtrl+Y",            ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "切り取り(&T)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "追加コピー(&E)",                   ID_EDIT_COPY_APPEND
        MENUITEM "引用付きコピー(&F)",                 ID_EDIT_COPY_FOLLOW
        MENUITEM "貼り付け(&P)\tCtrl+V",            ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "削除(&D)\tDel",                 ID_EDIT_DELETE_CHAR
        MENUITEM "1行削除(&Y)",                    ID_EDIT_DELETE_LINE
        MENUITEM "行左削除(&L)",                    ID_EDIT_DELETE_LEFT
        MENUITEM "行右削除(&R)",                    ID_EDIT_DELETE_RIGHT
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&A)\tCtrl+A",           ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "大文字へ変換(&U)",                  ID_EDIT_UPPERCASE
        MENUITEM "小文字へ変換(&W)",                  ID_EDIT_LOWERCASE
    END
    POPUP "検索(&S)"
    BEGIN
        MENUITEM "検索(&F)",                      ID_FIND_SEARCH
        MENUITEM "前を検索(&P)",                    ID_FIND_PREV
        MENUITEM "次を検索(&N)",                    ID_FIND_NEXT
        MENUITEM "置換(&R)",                      ID_FIND_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "文書の先頭へ(&T)",                  ID_JUMP_FILETOP
        MENUITEM "文書の最後へ(&B)",                  ID_JUMP_FILEEND
        MENUITEM "指定行へ移動(&J)",                  ID_JUMP_LINE
        MENUITEM "タグジャンプ(&A)",                  ID_JUMP_TAG
        MENUITEM "最後に編集した場所(&L)",               ID_JUMP_LASTEDITPOS
        MENUITEM SEPARATOR
        MENUITEM "ファイルから検索(&G)",                ID_FIND_GREP
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "現在位置の文字コード",                  ID_VIEW_CHARCODE
        POPUP "エンコードの種類(&E)"
        BEGIN
            MENUITEM "自動選択",                        ID_ENCODE_AUTO
            MENUITEM SEPARATOR
            MENUITEM SEPARATOR
            MENUITEM "改行(CR+LF)",                   ID_LINEBREAK_CRLF
            MENUITEM "改行(CR)",                      ID_LINEBREAK_CR
            MENUITEM "改行(LF)",                      ID_LINEBREAK_LF
        END
        MENUITEM SEPARATOR
        MENUITEM "参照モード(&W)",                   ID_EDIT_READONLY
    END
    POPUP "設定(&O)"
    BEGIN
        MENUITEM "ツールバーは小さいボタンで(&T)",           ID_TOOLBAR_SMALL
        MENUITEM "キー割り当て(&K)...",               ID_OPTION_KEYMAP
        MENUITEM "動作環境(&P)...",                 ID_OPTION_ENV
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ヘルプ(&H)",                     ID_HELP
        MENUITEM "テキストエディタについて(&A)",            ID_APP_ABOUT
    END
END


